{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "life-patch-diary",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diary",
      "database_id": "local-diary"
    }
  ]
}
